{
  "version": 3,
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Developer build",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "PXHASH_BUILD_BENCHMARKS": "OFF",
        "PXHASH_BUILD_EXAMPLES": "ON",
        "PXHASH_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release build",
      "binaryDir": "${sourceDir}/build-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "PXHASH_BUILD_BENCHMARKS": "ON",
        "PXHASH_BUILD_EXAMPLES": "ON",
        "PXHASH_BUILD_TESTS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev"
    },
    {
      "name": "release",
      "configurePreset": "release"
    }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
